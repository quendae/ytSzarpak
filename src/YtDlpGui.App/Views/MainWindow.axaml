<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YtDlpGui.App.ViewModels"
        xmlns:models="using:YtDlpGui.Core.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
        x:Class="YtDlpGui.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Icon="/Assets/icon.ico"
        Width="960" Height="680"
        MinWidth="760" MinHeight="520"
        Title="YTSzarpak">

    <Panel>

        <DockPanel LastChildFill="True">

            <!-- Chrome bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BrushPanel}">
                <StackPanel>
                    <Grid Margin="20,14" ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Image Source="/Assets/icon.png" Width="30" Height="30" />
                            <TextBlock Text="YTSZARPAK" Classes="wordmark" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SignInStatusText}"
                                   IsVisible="{Binding SignInStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="muted"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Classes="icon"
                                Content="&#x2699;"
                                FontSize="16"
                                ToolTip.Tip="Settings"
                                Command="{Binding OpenSettingsCommand}" />
                    </Grid>
                    <!-- Signal line: the thin glow underscoring the wordmark in the brand sheet -->
                    <Border Height="2" Background="{StaticResource BrushSignalCyan}" Opacity="0.6" />
                </StackPanel>
            </Border>

            <!-- Body -->
            <ScrollViewer>
                <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18" MaxWidth="820" HorizontalAlignment="Stretch">

                    <!-- Grab bar -->
                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock Text="PASTE A LINK" Classes="eyebrow" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0"
                                     Text="{Binding UrlInput}"
                                     PlaceholderText="https://youtube.com/watch?v=…"
                                     FontSize="14"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="primary"
                                    Content="GRAB"
                                    MinWidth="110"
                                    Command="{Binding FetchCommand}"
                                    IsEnabled="{Binding !IsFetching}"
                                    VerticalAlignment="Stretch" />
                        </Grid>
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsFetching}" />
                        <TextBlock Text="{Binding FetchError}"
                                   IsVisible="{Binding FetchError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource BrushClawRed}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Format panel -->
                    <Border Grid.Row="1"
                            Classes="card"
                            IsVisible="{Binding FetchedVideo, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding FetchedVideo.Title}"
                                       FontSize="15" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <CheckBox Content="Audio only"
                                          IsChecked="{Binding IsAudioOnly}"
                                          IsEnabled="{Binding IsFfmpegAvailable}"
                                          ToolTip.Tip="{Binding FfmpegWarning}" />

                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            IsVisible="{Binding !IsAudioOnly}"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Quality" Classes="muted" VerticalAlignment="Center" />
                                    <ComboBox MinWidth="190"
                                              ItemsSource="{Binding FetchedVideo.VideoFormats}"
                                              SelectedItem="{Binding SelectedFormat}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:FormatOption">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            IsVisible="{Binding IsAudioOnly}"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Format" Classes="muted" VerticalAlignment="Center" />
                                    <ComboBox MinWidth="110"
                                              ItemsSource="{x:Static vm:MainWindowViewModel.AudioFormats}"
                                              SelectedItem="{Binding SelectedAudioFormat}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding FetchedVideo.IsPlaylist}">
                                <CheckBox Content="Queue the entire playlist"
                                          IsChecked="{Binding QueueEntirePlaylist}" />
                                <TextBlock Text="A playlist URL always downloads every entry. To grab a single video, paste that video's own URL instead."
                                           Classes="hint" />
                            </StackPanel>

                            <Button Content="Add to Queue"
                                    Classes="ghost"
                                    HorizontalAlignment="Left"
                                    Command="{Binding AddToQueueCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Banners -->
                    <StackPanel Grid.Row="2" Spacing="8">

                        <!-- ffmpeg missing -->
                        <Border Classes="banner"
                                IsVisible="{Binding !IsFfmpegAvailable}"
                                Background="#26F0A202"
                                BorderBrush="{StaticResource BrushWarning}">
                            <TextBlock Text="{Binding FfmpegWarning}" TextWrapping="Wrap" />
                        </Border>

                        <!-- yt-dlp update -->
                        <Border Classes="banner"
                                IsVisible="{Binding UpdateAvailableMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Background="#2635C7F0"
                                BorderBrush="{StaticResource BrushSignalCyan}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding UpdateAvailableMessage}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="Update now"
                                        IsVisible="{Binding !IsUpdating}"
                                        Command="{Binding UpdateNowCommand}"
                                        VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1"
                                             IsVisible="{Binding IsUpdating}"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding UpdateProgress, Mode=OneWay}"
                                             Width="140"
                                             VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Queue -->
                    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="QUEUE" Classes="eyebrow" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Content="Clear"
                                    Padding="12,4"
                                    FontSize="11"
                                    Command="{Binding ClearQueueCommand}" />
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Queue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:QueueItemViewModel">
                                    <Border Classes="card" Margin="0,0,0,8" Padding="0">
                                        <Grid ColumnDefinitions="4,*">
                                            <Border Grid.Column="0"
                                                    Background="{Binding StatusColor}"
                                                    CornerRadius="10,0,0,10" />
                                            <Grid Grid.Column="1"
                                                  Margin="14,12"
                                                  ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="12">
                                                <StackPanel Grid.Column="0" Spacing="6">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontWeight="SemiBold" />
                                                    <ProgressBar Minimum="0" Maximum="100"
                                                                 Value="{Binding DisplayPercent, Mode=OneWay}"
                                                                 IsIndeterminate="{Binding IsIndeterminate}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                                        <TextBlock Text="{Binding Status}" Classes="muted" />
                                                        <TextBlock Text="{Binding Speed}" Classes="muted" />
                                                        <TextBlock Text="{Binding Eta}" Classes="muted" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ResultMessage}"
                                                               Classes="muted"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding ResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Classes="ghost" Content="Cancel" Padding="10,6" FontSize="11" Command="{Binding CancelCommand}" />
                                                    <Button Classes="ghost" Content="Show in folder" Padding="10,6" FontSize="11" Command="{Binding ShowInFolderCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <!-- Bootstrap overlay -->
        <Border IsVisible="{Binding IsBootstrapping}" Background="{StaticResource BrushVoid}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="16" Width="360">
                <Image Source="/Assets/icon.png" Width="72" Height="72" HorizontalAlignment="Center" />
                <TextBlock Text="YTSZARPAK" Classes="wordmark" FontSize="22" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BootstrapMessage}"
                           Classes="muted"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <ProgressBar Minimum="0" Maximum="100"
                             Value="{Binding BootstrapProgress, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Panel>
</Window>
