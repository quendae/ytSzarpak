<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YtDlpGui.App.ViewModels"
        xmlns:models="using:YtDlpGui.Core.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
        x:Class="YtDlpGui.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Icon="/Assets/icon.ico"
        Width="960" Height="680"
        MinWidth="760" MinHeight="520"
        Title="YTSzarpak">

    <Panel>
        <DockPanel LastChildFill="True">

            <!-- App bar -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource BrushTopBar}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,13" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <Image Source="/Assets/icon.png" Width="30" Height="30" />
                        <TextBlock Text="YTSzarpak"
                                   Classes="brand"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Classes="status-chip"
                            IsVisible="{Binding SignInStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SignInStatusText}"
                                   Classes="muted"
                                   FontSize="11" />
                    </Border>

                    <Button Grid.Column="2"
                            Classes="icon"
                            Content="&#x2699;"
                            FontSize="16"
                            ToolTip.Tip="Settings"
                            Command="{Binding OpenSettingsCommand}" />
                </Grid>
            </Border>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Padding="20,8">
                <TextBlock Text="{Binding VersionText}"
                           Classes="hint"
                           HorizontalAlignment="Center" />
            </Border>

            <!-- Body -->
            <ScrollViewer>
                <Grid Margin="28,24,28,18"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="18"
                      MaxWidth="840"
                      HorizontalAlignment="Stretch">

                    <!-- URL input -->
                    <StackPanel Grid.Row="0" Spacing="9">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Download a video" Classes="page-title" />
                            <TextBlock Text="Paste a link, choose a format and add it to the download queue."
                                       Classes="muted" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0"
                                     Text="{Binding UrlInput}"
                                     PlaceholderText="Paste a YouTube, TikTok or other supported link"
                                     FontSize="14"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="primary"
                                    Content="Grab"
                                    MinWidth="110"
                                    Command="{Binding FetchCommand}"
                                    IsEnabled="{Binding !IsFetching}"
                                    VerticalAlignment="Stretch" />
                        </Grid>

                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding IsFetching}" />

                        <TextBlock Text="{Binding FetchError}"
                                   IsVisible="{Binding FetchError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource BrushAccent}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Format panel -->
                    <Border Grid.Row="1"
                            Classes="card"
                            IsVisible="{Binding FetchedVideo, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="13">
                            <TextBlock Grid.Row="0"
                                       Text="{Binding FetchedVideo.Title}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                                <CheckBox Grid.Column="0"
                                          Content="Audio only"
                                          IsChecked="{Binding IsAudioOnly}"
                                          IsEnabled="{Binding IsFfmpegAvailable}"
                                          ToolTip.Tip="{Binding FfmpegWarning}"
                                          VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            IsVisible="{Binding !IsAudioOnly}"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Quality"
                                               Classes="label"
                                               VerticalAlignment="Center" />
                                    <ComboBox MinWidth="190"
                                              ItemsSource="{Binding FetchedVideo.VideoFormats}"
                                              SelectedItem="{Binding SelectedFormat}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:FormatOption">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            IsVisible="{Binding IsAudioOnly}"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Format"
                                               Classes="label"
                                               VerticalAlignment="Center" />
                                    <ComboBox MinWidth="120"
                                              ItemsSource="{x:Static vm:MainWindowViewModel.AudioFormats}"
                                              SelectedItem="{Binding SelectedAudioFormat}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="Add to queue"
                                        Classes="primary"
                                        Command="{Binding AddToQueueCommand}"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="2"
                                        Spacing="4"
                                        IsVisible="{Binding FetchedVideo.IsPlaylist}">
                                <CheckBox Content="Queue the entire playlist"
                                          IsChecked="{Binding QueueEntirePlaylist}" />
                                <TextBlock Text="A playlist URL downloads every entry. Paste a video's own URL to download only that item."
                                           Classes="hint" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Banners -->
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Border Classes="banner"
                                IsVisible="{Binding !IsFfmpegAvailable}"
                                Background="#1FD6A443"
                                BorderBrush="{StaticResource BrushWarning}">
                            <TextBlock Text="{Binding FfmpegWarning}" TextWrapping="Wrap" />
                        </Border>

                        <Border Classes="banner"
                                IsVisible="{Binding UpdateAvailableMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Background="#1F5B8DEF"
                                BorderBrush="{StaticResource BrushInfo}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding UpdateAvailableMessage}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="Update now"
                                        IsVisible="{Binding !IsUpdating}"
                                        Command="{Binding UpdateNowCommand}"
                                        VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1"
                                             IsVisible="{Binding IsUpdating}"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding UpdateProgress, Mode=OneWay}"
                                             Width="140"
                                             VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Queue -->
                    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Download queue"
                                       Classes="section-title"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="text"
                                    Content="Clear"
                                    FontSize="11"
                                    Command="{Binding ClearQueueCommand}" />
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Queue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:QueueItemViewModel">
                                    <Border Classes="card" Margin="0,0,0,8" Padding="0">
                                        <Grid ColumnDefinitions="4,*,Auto">
                                            <Border Grid.Column="0"
                                                    Background="{Binding StatusColor}"
                                                    CornerRadius="12,0,0,12" />

                                            <StackPanel Grid.Column="1"
                                                        Margin="15,13"
                                                        Spacing="7">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontWeight="SemiBold" />

                                                <ProgressBar Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding DisplayPercent, Mode=OneWay}"
                                                             IsIndeterminate="{Binding IsIndeterminate}" />

                                                <StackPanel Orientation="Horizontal" Spacing="14">
                                                    <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" />
                                                    <TextBlock Text="{Binding Speed}" Classes="muted" FontSize="11" />
                                                    <TextBlock Text="{Binding Eta}" Classes="muted" FontSize="11" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding ResultMessage}"
                                                           Classes="hint"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding ResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Margin="0,0,14,0"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">
                                                <Button Classes="ghost"
                                                        Content="Cancel"
                                                        Padding="10,6"
                                                        FontSize="11"
                                                        Command="{Binding CancelCommand}" />
                                                <Button Classes="ghost"
                                                        Content="Show in folder"
                                                        Padding="10,6"
                                                        FontSize="11"
                                                        Command="{Binding ShowInFolderCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <!-- Bootstrap overlay -->
        <Border IsVisible="{Binding IsBootstrapping}"
                Background="#F5101215">
            <Border Classes="card"
                    Width="380"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <Image Source="/Assets/icon.png"
                           Width="54" Height="54"
                           HorizontalAlignment="Center" />
                    <TextBlock Text="Getting things ready"
                               Classes="section-title"
                               FontSize="17"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding BootstrapMessage}"
                               Classes="muted"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{Binding BootstrapProgress, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>
